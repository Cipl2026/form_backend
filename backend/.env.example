PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/employee_details
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
ADMIN_NAME=HR Administrator
ADMIN_EMAIL=hr@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
# ── DigitalOcean Spaces (S3-compatible) ──
# Endpoint looks like https://blr1.digitaloceanspaces.com (or your region)
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=your-space-name
DO_SPACES_KEY=your-spaces-key
DO_SPACES_SECRET=your-spaces-secret
# Optional: CDN endpoint, e.g. https://your-space.blr1.cdn.digitaloceanspaces.com
DO_SPACES_CDN=
DO_SPACES_PREFIX=employees
# true = files get public-read ACL so the stored URL opens directly
DO_SPACES_PUBLIC=true
